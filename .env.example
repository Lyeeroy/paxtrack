# TMDB v3 API key — https://www.themoviedb.org/settings/api
# Used by the server-side metadata routes. Required.
TMDB_API_KEY=your_tmdb_v3_api_key

# Supabase project credentials — https://supabase.com/dashboard/project/_/settings/api-keys
# Both are public and safe to expose in the browser; Row Level Security protects data.
# Leave both empty to run the app as a local-only, offline tracker.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Older Supabase projects may use the legacy anon key instead. The app accepts
# either name, and the publishable key takes precedence when both are set.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
